{ 
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/api/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/user/:path*"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/dashboard/:path*"
    },
    {
      "source": "/students/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/students/:path*"
    },
    {
      "source": "/certificates/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/certificates/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/auth/:path*"
    },
    {
      "source": "/subscription/:path*",
      "destination": "https://certifypro-backend-lkkk.onrender.com/subscription/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
