# CertifyPro local environment template.
# Copy to `.env` at the REPO ROOT (frontend sets `envDir: ".."` in
# frontend/vite.config.ts, so Vite loads the root .env, not frontend/.env).
# Backend also loads backend/.env first; keep the two in sync.
# cp .env.example .env   (then fill in real values; never commit .env)

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_BASE_URL=http://127.0.0.1:8000

# Cloudflare Turnstile site key (public; safe to expose in the frontend).
# For local dev / Preview / automated tests use a Turnstile test site key:
#   1x00000000000000000000AA  -> widget always passes
#   2x00000000000000000000AB  -> widget always blocks (tests error handling)
#   3x00000000000000000000FF  -> forces an interactive challenge
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# When empty, the widget is skipped and forms stay usable (pre-enforcement mode).
VITE_CAPTCHA_SITE_KEY=

# --- Backend (FastAPI on Render) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
FRONTEND_ORIGINS=http://localhost:5173
ACCESS_INVITE_REDIRECT_URL=http://localhost:5173/reset-password?type=invite
API_BASE_URL=http://127.0.0.1:8000
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify
