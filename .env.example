# CertifyPro — Central Environment Template (Root)

# Application
NODE_ENV=development
APP_NAME=CertifyPro
APP_ENV=local

# Frontend (Vite)

VITE_APP_NAME=CertifyPro
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Supabase (Client-safe values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API (FastAPI planned)
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1
LOG_LEVEL=info

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# Format: postgresql+psycopg://user:password@host:port/db_name
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20


# Authentication / Security
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase server-side (backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=
APP_LOGIN_URL=http://localhost:8080/login


# Email / Notifications

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@certifypro.local
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@certifypro.app

# Object Storage (for certificate assets/uploads)
# Choose one provider section as needed.

# S3-compatible
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Azure Blob (optional alternative)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

OPENAI_API_KEY=


# Feature Flags 
ENABLE_AUTOMATED_VERIFICATION_SCORING=false
ENABLE_SUPABASE_AUTH_LINKING=false
ENABLE_ADMIN_REVIEW_WORKFLOW=true

